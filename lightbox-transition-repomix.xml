<file path="/mnt/c/Users/Administrator/Downloads/lightbox-demo/lightbox-demo/script.js">
const grid = document.querySelector('.masonry');
const box = document.querySelector('.lightbox');
const big = box.querySelector('img');
let origin = null;

// Falls back to an instant swap if the browser has no View Transitions support
const swap = (fn) =>
  document.startViewTransition ? document.startViewTransition(fn) : (fn(), null);

function open(thumb) {
  origin = thumb;

  // Only ONE element can hold the name at a time
  thumb.style.viewTransitionName = 'photo';

  swap(() => {
    big.src = thumb.currentSrc || thumb.src;
    box.hidden = false;
    thumb.style.viewTransitionName = '';
    big.style.viewTransitionName = 'photo';
  });
}

function close() {
  if (box.hidden || !origin) return;
  const t = swap(() => {
    big.style.viewTransitionName = '';
    origin.style.viewTransitionName = 'photo';
    box.hidden = true;
  });
  const cleanup = () => { origin.style.viewTransitionName = ''; };
  t ? t.finished.then(cleanup) : cleanup();
}

grid.addEventListener('click', (e) => {
  const thumb = e.target.closest('img');
  if (thumb) open(thumb);
});

box.addEventListener('click', close);
document.addEventListener('keydown', (e) => {
  if (e.key === 'Escape') close();
});
